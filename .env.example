# Скопируйте в .env и заполните ключ: cp .env.example .env

DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
RABBITMQ_URL=amqp://rag:rag@localhost:5672/
REDIS_URL=redis://localhost:6379/0

# Контакт для User-Agent загрузчика adilet (e-mail или ссылка на репозиторий)
FETCH_CONTACT=

ANTHROPIC_API_KEY=
LLM_PRIMARY_MODEL=claude-sonnet-5-5
LLM_FALLBACK_MODEL=claude-haiku-5-5

EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
